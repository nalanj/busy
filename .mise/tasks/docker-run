#!/bin/bash
# Run a busy agent in an isolated Docker container
# Usage: docker-run --config <path>

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../.."
PROJECT_DIR="$(pwd)"

# Find config file
if [ "$1" = "--config" ] && [ -n "$2" ]; then
    CONFIG_FILE="$2"
    shift 2  # Consume the arguments so Mise doesn't pass them to docker
else
    echo "Error: --config <path> is required"
    exit 1
fi

# Convert to absolute path
CONFIG_FILE="$(cd "$(dirname "$CONFIG_FILE")" && pwd)/$(basename "$CONFIG_FILE")"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file not found: $CONFIG_FILE"
    exit 1
fi

# Build image if needed
if ! docker image inspect nalanj/busy:latest &>/dev/null; then
    echo "Building busy image..."
    mise run docker-build
fi

# Create state directory
mkdir -p state

# Run container - FULLY ISOLATED
docker run \
    --rm \
    --name "busy" \
    --hostname "busy" \
    --network host \
    -e ANTHROPIC_API_KEY \
    -e OPENAI_API_KEY \
    -v "$CONFIG_FILE:/config/agent.yaml:ro" \
    -v "$PROJECT_DIR/state:/root/.local/share/busy" \
    -w /workspace \
    nalanj/busy:latest \
    --config /config/agent.yaml
